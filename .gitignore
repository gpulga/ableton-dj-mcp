.env

# Generated JS from TypeScript in portal
src/portal/*.js
src/portal/*.js.map

# Generated JS from Peggy grammars
src/notation/*/parser/generated-*-parser.js

# Generated build-info (branch/sha/dirty/buildTime baked at build)
src/generated/

# Python bytecode caches (live_browser_bridge/ ships as plain source)
__pycache__/
*.pyc

# Generated docs artifacts
docs/_generated
docs/public/markdown

# VitePress Documentation Site
docs/.vitepress/dist
docs/.vitepress/cache

# Eval results (generated JSON)
evals/results

# Playwright Test Results
test-results
report/

# Live project backups
**/live-sets/**/Backup

# Personal/local-only files (notes, scratch tests, machine-specific configs)
local/

# User's personal music context (scaffolded from workspace.template/ via npm run init:workspace)
# Entirely private — projects, findings, genres, techniques, AI instructions
# never leave the user's machine.
workspace/

# Personal Live projects saved at the repo root (e2e fixtures live under e2e/)
/*\ Project/
